# PostgreSQL (Neon: use the pooled URL here and the direct URL below)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/goldenspoon"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/goldenspoon"

# Long random string used to sign admin sessions: `openssl rand -base64 32`
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@goldenspoon.com"
ADMIN_PASSWORD="change-me"

# Lost the admin login? Set ADMIN_RESET="true", redeploy, and log in with ADMIN_EMAIL / ADMIN_PASSWORD.
# That replaces the admin account. Remove ADMIN_RESET afterwards and redeploy.
# ADMIN_RESET="true"
